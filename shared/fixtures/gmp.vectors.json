      "ceiling": "150000.00",
      "contingency": "0.00",
      "signed_cos": [],
      "expect": {
        "contingency_used": "0.00",
        "contingency_remaining": "0.00",
        "ceiling_adjustments": "0.00",
        "adjusted_ceiling": "150000.00",
        "pct_remaining": "0.00"
      }
    }
