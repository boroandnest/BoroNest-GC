        "reviewTier": "fnb",
        "reviewPrice": "2250.00"
      }
    },
    {
      "name": "same concept, outer borough \u2014 the band scales down, not shifts",
      "input": {
        "conceptKey": "coffee_fast_casual",
        "sqft": 1200,
        "borough": "outer",
        "condition": "second_same"
      },
      "expect": {
